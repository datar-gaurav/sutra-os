<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sutra Fleet — host worker launchd agent.

  This is a TEMPLATE. install.sh renders it into ~/Library/LaunchAgents/
  with real values substituted for the __VAR__ markers. Do not load this
  file directly — load the rendered copy.

  After install:
    launchctl list | grep sutra              # verify
    tail -f ~/Library/Logs/sutra-fleet.log   # watch runs

  Re-render after changing token/paths: re-run ./install.sh
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sutra.fleet-worker</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>__PROJECT_DIR__/scripts/fleet_worker.py</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>SUTRA_URL</key>
    <string>http://localhost:8000</string>

    <key>FLEET_WORKER_TOKEN</key>
    <string>__FLEET_WORKER_TOKEN__</string>

    <key>FLEET_WORKER_ID</key>
    <string>__HOSTNAME__</string>

    <key>GITHUB_TOKEN</key>
    <string>__GITHUB_TOKEN__</string>

    <key>FLEET_WORKSPACE_ROOT</key>
    <string>__HOME__/agent_workspaces</string>

    <key>GEMINI_HOME</key>
    <string>__HOME__/.gemini-fleet-home</string>

    <key>FLEET_GEMINI_MODEL</key>
    <string>gemini-2.5-pro</string>

    <key>FLEET_WORKER_PORT</key>
    <string>7476</string>

    <key>FLEET_RUN_TIMEOUT_SEC</key>
    <string>1800</string>

    <!-- Optional: run Forge requests on Shakha (Sutra CODE_EXECUTOR=shakha).
         Point this at the `shakha` command; GEMINI_HOME / GITHUB_TOKEN are
         then only needed if you also keep the Gemini runner.
    <key>SHAKHA_BIN</key>
    <string>/Users/YOU/Coding/git/shakha/bin/shakha</string>
    -->

    <!-- Optional: Claude Code provider (purpose slot provider "claude_code").
         Uses your Claude subscription: run `claude` once and sign in. The
         worker finds the CLI on PATH or at ~/.local/bin/claude by default.
         Each agent gets a folder under CLAUDE_WORKSPACE_ROOT
         (default: FLEET_WORKSPACE_ROOT/claude-code).
    <key>CLAUDE_BIN</key>
    <string>/Users/YOU/.local/bin/claude</string>
    <key>CLAUDE_WORKSPACE_ROOT</key>
    <string>/Users/YOU/agent_workspaces/claude-code</string>
    <key>CLAUDE_MAX_CONCURRENT</key>
    <string>2</string>
    -->

    <!-- Optional: Codex provider (purpose slot provider "codex").
         Uses your ChatGPT subscription: run `codex login` and choose Sign in
         with ChatGPT. Found on PATH or at ~/.local/bin/codex by default.
    <key>CODEX_BIN</key>
    <string>/Users/YOU/.local/bin/codex</string>
    <key>CODEX_WORKSPACE_ROOT</key>
    <string>/Users/YOU/agent_workspaces/codex</string>
    <key>CODEX_MAX_CONCURRENT</key>
    <string>2</string>
    -->

    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>KeepAlive</key>
  <true/>

  <key>RunAtLoad</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/sutra-fleet.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/sutra-fleet.log</string>

  <key>ProcessType</key>
  <string>Background</string>

  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
