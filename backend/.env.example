# Sutra environment variables

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sutra:sutra_dev@localhost:5432/sutra

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── LLM API Keys (optional) ────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ─── Slack (optional — for Slack bot integration) ────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ─── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── WhatsApp (optional — Meta Cloud API) ────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=sutra-whatsapp-verify
WHATSAPP_APP_SECRET=

# ─── Agent Tools ─────────────────────────────────────────────────────────────
ALLOWED_AGENT_FILE_PATHS=

# ─── Scheduled Check-ins ─────────────────────────────────────────────────────
# Cron expression for daily agent check-ins (America/Los_Angeles timezone)
# Default: 8:00 AM Pacific — change hour/minute to reschedule
CHECKIN_CRON=0 8 * * *

# ─── AFFiNE (optional) ───────────────────────────────────────────────────────
AFFINE_BASE_URL=https://app.affine.pro
AFFINE_TOKEN=
